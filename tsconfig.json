{
  "files": [],
	"compilerOptions": {
    "target": "ES2020",
    "baseUrl": ".",
    "allowJs": true,
    "skipLibCheck": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "disableSourceOfProjectReferenceRedirect": true,

    //
    // TypeChecking
    //
    // strict:
    // Enable all strict type-checking options.
    // Turning this on is equivalent to enabling all of the strict mode family options, which are outlined below.
    //
    //   alwaysStrict:
    //     Ensure 'use strict' is always emitted.
    //   strictNullChecks:
    //     When type checking, take into account 'null' and 'undefined'.
    //   strictBindCallApply:
    //     Check that the arguments for 'bind', 'call', and 'apply' methods match the original function.
    //   strictFunctionTypes:
    //     When assigning functions, check to ensure parameters and the return values are subtype-compatible.
    //   strictPropertyInitialization:
    //     Check for class properties that are declared but not set in the constructor.
    //   noImplicitAny:
    //     Enable error reporting for expressions and declarations with an implied 'any' type.
    //   noImplicitThis:
    //     Enable error reporting when 'this' is given the type 'any'.
    //   useUnknownInCatchVariables:
    //     Default catch clause variables as 'unknown' instead of 'any'.
    // https://www.typescriptlang.org/tsconfig/#strict
    //
    "strict": true
  },
  "references": [
    { "path": "packages/import-internal-esmodule" },
    { "path": "packages/local-import-checker" },
    { "path": "packages/named-exports-no-default" },
    { "path": "packages/named-exports-with-default" }
  ]
}
